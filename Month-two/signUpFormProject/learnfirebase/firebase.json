{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/pages/index.html"
      },
      {
        "source": "/index.html",
        "destination": "/pages/index.html"
      },
      {
        "source": "/login.html",
        "destination": "/pages/login.html"
      },
      {
        "source": "/signup.html",
        "destination": "/pages/signup.html"
      },
      {
        "source": "/dashboard.html",
        "destination": "/pages/dashboard.html"
      }
    ]
  }
}
